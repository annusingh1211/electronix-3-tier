pipeline {
    agent {
        label 'electronix'
    }

    environment {
        ECR_REPO  = '540034108652.dkr.ecr.eu-north-1.amazonaws.com/electronix-ecr'
        AWS_REGION = 'eu-north-1'
    }

    stages {
        stage('Test ECR Login') {
            steps {
                sh '''
                aws ecr get-login-password --region ${AWS_REGION} | \
                docker login --username AWS --password-stdin ${ECR_REPO}
                '''
            }
        }
    }

    post {
        success {
            echo 'ECR Login Success ✅'
        }

        failure {
            echo 'ECR Login Failed ❌'
        }
    }
}