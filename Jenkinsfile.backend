pipeline{
    agent {label 'electronix'}

    environment {
        ECR_REPO='540034108652.dkr.ecr.eu-north-1.amazonaws.com/electronix-ecr'
        AWS_REGION = "eu-north-1"
        PRODUCTION_IP='51.20.221.170'

    }

    stages{

            stage('Build Docker Image'){
                steps{
                    dir("backend"){
                        sh 'docker build -t electronix-backend:${BUILD_NUMBER} .'
                    }
                }
            }

            stage("Test ECR Login"){
                steps {
                    sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REPO}
                    '''
                }
            }

            stage ("Tag & Push to ECR"){
                steps{
                    sh '''
                    docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                    docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:latest
                    docker push ${ECR_REPO}:${BUILD_NUMBER}
                    docker push ${ECR_REPO}:latest

                    echo "Pushed Success ✅"
                    '''
                }
            }

              stage ("Deploy To Production"){
                steps{
                    sshagent(['prod-server-ssh-key']){
                    sh '''
                    ssh -o StrictHostKeyChecking=no ubuntu@${PRODUCTION_IP} "
                    aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REPO} &&
                    docker pull ${ECR_REPO}:latest &&
                    docker stop electronix-backend || true &&
                    docker rm electronix-backend || true &&
                    docker run -d --name electronix-backend --env-file /home/ubuntu/.env -v /home/ubuntu/uploads:/app -p 5000:5000 ${ECR_REPO}:latest
                    "
                    '''
                    }
                    
                }
            }

            stage ("Health Check"){
                steps{
                    sh 'sleep 10 && curl -f http://${PRODUCTION_IP}:5000/api/health || exit 1'
                }
            }
}


  post {
    success{
        echo "ECR login success ✅"
    }

    failure {
        echo "ECR login Failed ❌"
    }
  }

}